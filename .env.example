# Optional source-repository overrides for reference-catalog generation.
# Relative paths are resolved lexically from the logical acmm_explorer path
# before symlinks are followed. With sibling WSL links under ~/, the defaults
# below resolve to ~/acmm_repo and ~/acmm_experiments even when
# ~/acmm_explorer itself is a symlink.
ACMM_CORE_REPO=../acmm_repo
ACMM_EXPERIMENTS_REPO=../acmm_experiments
